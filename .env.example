# ---------------------------------------------------------------------------
# Domuzz — environment variables
#
# Copy this file to `.env.local` (or `.env`) and fill in your own values:
#   cp .env.example .env.local
#
# Never commit real credentials. `.env*` files are git-ignored except for this
# example file.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Postgres connection string. Neon serverless Postgres is used in development
# and production: https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Listing data (required for /compare and /cma) -------------------------
# Apify API token used to run the Zillow scrapers.
# Get one at https://console.apify.com/account/integrations
APIFY_TOKEN="your_apify_token_here"

# --- AI (optional) ---------------------------------------------------------
# Google Gemini API key. When unset, AI-generated summaries/analysis is skipped
# and the app falls back to deterministic output.
# Get one at https://aistudio.google.com/apikey
GEMINI_API="your_gemini_api_key_here"

# --- Photos (optional) -----------------------------------------------------
# Google Maps API key with the Street View Static API enabled. When unset,
# listings fall back to their Zillow photos.
# https://developers.google.com/maps/documentation/streetview/get-api-key
GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# --- Email capture (optional) ----------------------------------------------
# Resend API key used to send report emails and sync leads to an audience.
# https://resend.com/api-keys
RESEND_API_KEY="your_resend_api_key_here"
RESEND_FROM_EMAIL="hello@example.com"

# --- Analytics (optional) --------------------------------------------------
# Google Analytics 4 measurement ID. Defaults to the project's public ID when
# unset; set it to your own property in a fork.
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- Rate limiting (optional) ----------------------------------------------
# Defaults: 5 CMA requests per IP per 60 minutes.
CMA_RATE_LIMIT_MAX="5"
CMA_RATE_LIMIT_WINDOW_MINUTES="60"
# Set to "true" to disable rate limiting entirely (never do this in production).
DISABLE_RATE_LIMIT="false"
